{
  "name": "@katanaperps/katana-perps-contracts-niseko",
  "version": "1.0.0-sandbox-add-chainlink-oracle-adapter.1",
  "description": "Collects source code, tests, and documentation for the Katana Perps Niseko release Solidity contracts",
  "homepage": "https://github.com/katanaperps/katana-perps-contracts-niseko",
  "repository": "https://github.com/katanaperps/katana-perps-contracts-niseko",
  "license": "MIT",
  "packageManager": "yarn@4.2.1",
  "main": "build/lib/index.js",
  "types": "build/lib/index.d.ts",
  "directories": {
    "lib": "build/lib"
  },
  "files": [
    "artifacts/contracts/bridge-adapters/libraries/ExchangeAdapterComposing_v1.sol/ExchangeAdapterComposing_v1.json",
    "artifacts/contracts/bridge-adapters/libraries/KatanaPerpsStargateForwarderComposing_v1.sol/KatanaPerpsStargateForwarderComposing_v1.json",
    "artifacts/contracts/libraries/BalanceLoading.sol/BalanceLoading.json",
    "artifacts/contracts/libraries/ClosureDeleveraging.sol/ClosureDeleveraging.json",
    "artifacts/contracts/libraries/Depositing.sol/Depositing.json",
    "artifacts/contracts/libraries/ExitFund.sol/ExitFund.json",
    "artifacts/contracts/libraries/Funding.sol/Funding.json",
    "artifacts/contracts/libraries/IndexPriceMargin.sol/IndexPriceMargin.json",
    "artifacts/contracts/libraries/ManagedAccounts.sol/ManagedAccounts.json",
    "artifacts/contracts/libraries/MarketAdmin.sol/MarketAdmin.json",
    "artifacts/contracts/libraries/NonceInvalidations.sol/NonceInvalidations.json",
    "artifacts/contracts/libraries/OraclePriceMargin.sol/OraclePriceMargin.json",
    "artifacts/contracts/libraries/PositionBelowMinimumLiquidation.sol/PositionBelowMinimumLiquidation.json",
    "artifacts/contracts/libraries/PositionInDeactivatedMarketLiquidation.sol/PositionInDeactivatedMarketLiquidation.json",
    "artifacts/contracts/libraries/Trading.sol/Trading.json",
    "artifacts/contracts/libraries/Transferring.sol/Transferring.json",
    "artifacts/contracts/libraries/WalletExitAcquisitionDeleveraging.sol/WalletExitAcquisitionDeleveraging.json",
    "artifacts/contracts/libraries/WalletExitLiquidation.sol/WalletExitLiquidation.json",
    "artifacts/contracts/libraries/WalletInMaintenanceAcquisitionDeleveraging.sol/WalletInMaintenanceAcquisitionDeleveraging.json",
    "artifacts/contracts/libraries/WalletInMaintenanceLiquidation.sol/WalletInMaintenanceLiquidation.json",
    "artifacts/contracts/libraries/Withdrawing.sol/Withdrawing.json",
    "build/lib",
    "build/typechain-types"
  ],
  "scripts": {
    "build": "yarn build:sol && yarn build:ts",
    "build:clean": "rm -rf build && rm -rf artifacts && rm -rf cache && rm -rf typechain-types",
    "build:sol": "hardhat compile",
    "build:ts": "tsc -p .",
    "test:coverage": "COVERAGE=1 hardhat coverage",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:cache": "solhint --cache 'contracts/**/*.sol'",
    "postinstall": "yarn setup:git:hooks",
    "setup:git:hooks": "git config --local core.hooksPath .githooks || echo 'Not a git repository, did not set up git hooks'",
    "test": "COVERAGE=1 hardhat test"
  },
  "dependencies": {
    "@prb/math": "4.1.0",
    "ethers": "6.13.5",
    "solidity-bytes-utils": "0.8.3",
    "uuid": "8.3.2"
  },
  "devDependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@commitlint/config-conventional": "^17.7.0",
    "@eslint/eslintrc": "^3.0.2",
    "@eslint/js": "^8.57.0",
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.80",
    "@layerzerolabs/lz-evm-oapp-v2": "^2.3.3",
    "@layerzerolabs/lz-evm-protocol-v2": "^2.3.3",
    "@layerzerolabs/oapp-evm": "^0.3.0",
    "@layerzerolabs/oft-evm": "^3.1.1",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "@openzeppelin/contracts": "5.2.0",
    "@openzeppelin/contracts-upgradeable": "5.2.0",
    "@pythnetwork/pyth-sdk-solidity": "2.4.0",
    "@redstone-finance/evm-connector": "0.9.0",
    "@tsconfig/node20": "^20.1.2",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "^4.3.4",
    "@types/chai-as-promised": "^7.1.5",
    "@types/dotenv": "^8.2.3",
    "@types/minimatch": "^6.0.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^12.0.0",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "bignumber.js": "^9.1.2",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "commitlint": "^17.7.2",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "npm:eslint-plugin-i@latest",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "7.34.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-ts-import": "^1.2.2",
    "hardhat": "2.22.16",
    "hardhat-contract-sizer": "^2.8.0",
    "mathjs": "^14.5.3",
    "mkdirp": "^3.0.1",
    "prettier": "^2.8.0",
    "prettier-plugin-solidity": "1.4.2",
    "solhint": "6.0.1",
    "solidity-coverage": "0.8.16",
    "ts-node": "^10.9.1",
    "typechain": "8.3.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.1.1"
  }
}
